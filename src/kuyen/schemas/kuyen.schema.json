{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leftraru.local/kuyen/kuyen.schema.json",
  "title": "KÜYEN canonical graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kuyen_id",
    "version",
    "antu_id",
    "mapu_ids",
    "schema_version",
    "status",
    "entities",
    "relations",
    "assertions",
    "evidence",
    "coverage",
    "provenance",
    "content_digest",
    "provenance_digest"
  ],
  "properties": {
    "kuyen_id": {
      "type": "string",
      "pattern": "^KUY-[a-f0-9]{12}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"
    },
    "antu_id": {
      "type": "string"
    },
    "mapu_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "const": "kuyen-native-v1"
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "ACCEPTED"
      ]
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "provenance": {
      "type": "object"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{20}$"
    },
    "provenance_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{20}$"
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": [
        "entity_id",
        "entity_type",
        "name",
        "aliases",
        "description",
        "evidence_ids",
        "sources",
        "status"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "pattern": "^ent_[a-f0-9]{20}$"
        },
        "entity_type": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string"
        },
        "source_entity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_namespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity_basis": {
          "type": "string"
        },
        "normalization_status": {
          "type": "string"
        },
        "normalization_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "relation": {
      "type": "object",
      "required": [
        "relation_id",
        "from_entity",
        "predicate",
        "to_entity",
        "label",
        "polarity",
        "scope",
        "evidence_ids",
        "sources",
        "status",
        "semantic_status"
      ],
      "properties": {
        "relation_id": {
          "type": "string",
          "pattern": "^rel_[a-f0-9]{20}$"
        },
        "from_entity": {
          "type": "string"
        },
        "predicate": {
          "type": "string"
        },
        "to_entity": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "polarity": {
          "enum": [
            "POSITIVE",
            "NEGATIVE"
          ]
        },
        "scope": {
          "type": "string"
        },
        "temporal_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string"
        },
        "semantic_status": {
          "type": "string"
        },
        "source_from_entity": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_to_entity": {
          "type": [
            "string",
            "null"
          ]
        },
        "from_normalization_status": {
          "type": "string"
        },
        "to_normalization_status": {
          "type": "string"
        },
        "normalization_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "assertion": {
      "type": "object",
      "required": [
        "assertion_id",
        "subject_entity",
        "predicate",
        "polarity",
        "scope",
        "evidence_ids",
        "sources",
        "status",
        "semantic_status"
      ],
      "properties": {
        "assertion_id": {
          "type": "string",
          "pattern": "^asrt_[a-f0-9]{20}$"
        },
        "subject_entity": {
          "type": "string"
        },
        "predicate": {
          "type": "string"
        },
        "object_entity": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": [
            "object",
            "null"
          ]
        },
        "polarity": {
          "enum": [
            "POSITIVE",
            "NEGATIVE"
          ]
        },
        "scope": {
          "type": "string"
        },
        "temporal_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string"
        },
        "semantic_status": {
          "type": "string"
        },
        "proposed_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "proposed_status_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_status": {
          "type": "string"
        }
      }
    }
  }
}
