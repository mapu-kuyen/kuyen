{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leftraru.local/kuyen/antu.schema.json",
  "title": "KÜYEN Antü v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "antu_id",
    "version",
    "purpose",
    "scope",
    "language",
    "ontology_profile",
    "entity_types",
    "relation_types",
    "coverage_policy",
    "evidence_policy",
    "scalar_policy",
    "conflict_policy",
    "output_profile"
  ],
  "properties": {
    "antu_id": {
      "type": "string",
      "pattern": "^(ANT|ANTU)-[A-Za-z0-9._-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include",
        "exclude"
      ],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "ontology_profile": {
      "const": "generic-v1"
    },
    "entity_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relation_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage_policy": {
      "enum": [
        "complete",
        "complete_with_reasons",
        "require_terminal",
        "not_required"
      ]
    },
    "evidence_policy": {
      "enum": [
        "strict",
        "document"
      ]
    },
    "scalar_policy": {
      "enum": [
        "literal",
        "allow_entities"
      ]
    },
    "conflict_policy": {
      "enum": [
        "preserve_unresolved",
        "reject_conflict"
      ]
    },
    "output_profile": {
      "const": "kuyen-native-v1"
    },
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "unresolved_policy": {
      "enum": [
        "allow",
        "reject"
      ]
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x-kuyen-fixture": {},
        "x-kuyen-fact-coverage": {"type": "object"},
        "x-kuyen-document-sections": {"type": "object"},
        "x-kuyen-temporal": {"type": "object"}
      }
    }
  }
}
