+"""Public, explicit OpenAI configuration for document-to-graph ingestion.
+
+The extraction model is never fixed inside the package and `gpt-6-luna` is neither a
+requirement nor an implicit fallback: the model is supplied by the caller or by the
+documented environment variable `KUYEN_OPENAI_MODEL`.
+
+The credential is *never* read here. This module only records the **name** of the
+environment variable that holds it and checks that it is present; the value is read by
+`kuyen.credentials.EnvironmentCredentialProvider` inside the trusted process, and it is
+never persisted, logged, serialized or included in an exception.
+"""
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass, replace
+from typing import Any
+
+from ..errors import OpenAIConfigurationError
+from .budget import PricingSnapshot
+
+API_KEY_ENV = "OPENAI_API_KEY"
+MODEL_ENV = "KUYEN_OPENAI_MODEL"
+TIMEOUT_ENV = "KUYEN_OPENAI_TIMEOUT"
+MAX_OUTPUT_TOKENS_ENV = "KUYEN_OPENAI_MAX_OUTPUT_TOKENS"
+
+DEFAULT_TIMEOUT_S = 180.0
+DEFAULT_MAX_OUTPUT_TOKENS = 6000
+DEFAULT_REASONING_EFFORT = "low"
+DEFAULT_SERVICE_TIER = "default"
+PROMPT_REVISION = "2026-11-02.1"
+
+BLOCKED_STATUS = "OPENAI_CONFIGURATION_BLOCKED"
+
+#: Environment variables this configuration understands. Documented in
+#: `docs/openai_document_to_graph.md` and `docs/openai_document_to_graph.es.md`.
+ENVIRONMENT_VARIABLES = (API_KEY_ENV, MODEL_ENV, TIMEOUT_ENV, MAX_OUTPUT_TOKENS_ENV)
+
+
+def _env_value(name: str) -> str | None:
+    raw = os.environ.get(name)
+    if raw is None:
+        return None
+    value = raw.strip()
+    return value or None
+
+
+@dataclass(frozen=True)
+class OpenAIConfig:
+    """How to reach OpenAI. Construct it, or use `from_environment()`.
+
+    | field | meaning | environment variable |
+    | --- | --- | --- |
+    | `api_key_env` | **name** of the variable holding the credential | — |
+    | `model` | extraction model identifier | `KUYEN_OPENAI_MODEL` |
+    | `timeout_s` | per-request timeout in seconds | `KUYEN_OPENAI_TIMEOUT` |
+    | `max_output_tokens` | output-token ceiling for the single request | `KUYEN_OPENAI_MAX_OUTPUT_TOKENS` |
+    | `pricing` | optional `PricingSnapshot`; without it no monetary cost is claimed | — |
+
+    `budget_usd` is a hard ceiling for the *estimate* of the one authorized request. When
+    `pricing` is absent the estimate is zero and no cost is reported, so the value only
+    documents intent; the single-call guarantee comes from the provider itself, which
+    issues exactly one request and disables SDK retries.
+    """
+
+    model: str | None = None
+    api_key_env: str = API_KEY_ENV
+    timeout_s: float | None = None
+    max_output_tokens: int | None = None
+    reasoning_effort: str = DEFAULT_REASONING_EFFORT
+    service_tier: str = DEFAULT_SERVICE_TIER
+    store: bool = False
+    pricing: PricingSnapshot | None = None
+    budget_usd: float | None = 1.0
+    prompt_revision: str = PROMPT_REVISION
+
+    @classmethod
+    def from_environment(cls, **overrides: Any) -> "OpenAIConfig":
+        """Build a configuration from the documented environment variables.
+
+        Explicit keyword arguments win over the environment, so a caller can pin the
+        model for one run without touching the process environment. Nothing is read from
+        the credential variable itself.
+        """
+        config = cls(
+            model=_env_value(MODEL_ENV),
+            timeout_s=_env_value(TIMEOUT_ENV),
+            max_output_tokens=_env_value(MAX_OUTPUT_TOKENS_ENV),
+        )
+        known = set(cls.__dataclass_fields__)
+        unknown = sorted(set(overrides) - known)
+        if unknown:
+            raise TypeError(f"OpenAIConfig has no field {unknown[0]!r}")
+        return replace(config, **overrides) if overrides else config
+
+    # -- resolution ---------------------------------------------------------
+    def resolve(self) -> "ResolvedOpenAIConfig":
+        """Validate the configuration; raise `OpenAIConfigurationError` if unusable.
+
+        The check happens before any extraction: a missing credential or a model that was
+        never configured produces `OPENAI_CONFIGURATION_BLOCKED`, naming the variable that
+        needs configuration and nothing else.
+        """
+        missing: list[str] = []
+        invalid: list[dict[str, str]] = []
+
+        model = (self.model or _env_value(MODEL_ENV) or "").strip()
+        if not model:
+            missing.append(MODEL_ENV)
+
+        api_key_env = (self.api_key_env or "").strip()
+        if not api_key_env:
+            missing.append(API_KEY_ENV)
+        elif not os.environ.get(api_key_env):
+            missing.append(api_key_env)
+
+        timeout_s = self.timeout_s
+        if timeout_s is None:
+            timeout_s = _env_value(TIMEOUT_ENV)
+        timeout = DEFAULT_TIMEOUT_S
+        if timeout_s is not None and str(timeout_s).strip():
+            try:
+                timeout = float(str(timeout_s).strip())
+            except (TypeError, ValueError):
+                invalid.append({"variable": TIMEOUT_ENV, "reason": "must be a number of seconds"})
+            else:
+                if not timeout > 0:
+                    invalid.append({"variable": TIMEOUT_ENV, "reason": "must be greater than zero"})
+
+        max_output_tokens = self.max_output_tokens
+        if max_output_tokens is None:
+            max_output_tokens = _env_value(MAX_OUTPUT_TOKENS_ENV)
+        tokens = DEFAULT_MAX_OUTPUT_TOKENS
+        if max_output_tokens is not None and str(max_output_tokens).strip():
+            try:
+                tokens = int(str(max_output_tokens).strip())
+            except (TypeError, ValueError):
+                invalid.append({"variable": MAX_OUTPUT_TOKENS_ENV,
+                                "reason": "must be a whole number of tokens"})
+            else:
+                if tokens <= 0:
+                    invalid.append({"variable": MAX_OUTPUT_TOKENS_ENV,
+                                    "reason": "must be greater than zero"})
+
+        if self.pricing is not None and self.budget_usd is not None:
+            if float(self.budget_usd) <= 0:
+                invalid.append({"variable": "budget_usd", "reason": "must be greater than zero"})
+
+        if missing or invalid:
+            code = BLOCKED_STATUS
+            detail = ", ".join(missing) if missing else "invalid configuration"
+            raise OpenAIConfigurationError(
+                f"{code}: configure the environment variable(s) {detail} before requesting extraction",
+                details={"status": code, "missing": missing, "invalid": invalid,
+                         "model_configured": bool(model),
+                         "credential_configured": bool(api_key_env) and not missing},
+            )
+
+        return ResolvedOpenAIConfig(
+            api_key_env=api_key_env, model=model, timeout_s=timeout,
