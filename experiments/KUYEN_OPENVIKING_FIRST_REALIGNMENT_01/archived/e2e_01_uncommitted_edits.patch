+EXTRACTION_SCHEMA_VERSION_V3 = "kuyen-extraction-candidate-v3"
+
+#: The eight statement kinds KÜYEN asks the extractor to distinguish. The stored value is a
+#: stable English token; the prompt maps each token to the Spanish category of the contract.
+STATEMENT_KINDS: tuple[str, ...] = (
+    "DIRECT_ASSERTION",       # AFIRMACIÓN DIRECTA
+    "ATTRIBUTED_STATEMENT",   # DECLARACIÓN ATRIBUIDA
+    "THIRD_PARTY_CLAIM",      # RECLAMACIÓN DE TERCERO
+    "ISSUER_REPORTED_FACT",   # HECHO REPORTADO POR EL EMISOR
+    "FUTURE_COMMITMENT",      # COMPROMISO FUTURO
+    "FORECAST",               # PREVISIÓN
+    "PENDING_VERIFICATION",   # PENDIENTE DE VERIFICACIÓN
+    "NO_INFORMATION",         # AUSENCIA DE INFORMACIÓN
+)
+
+
+def build_extraction_schema_v3(
+    *,
+    antu: Antu,
+    ontology: Ontology,
+    mapu_ids: list[str],
+    unit_ids: list[str],
+    source_uris: list[str],
+    source_sha256: str,
+    source_characters: int,
+    sections: list[dict[str, Any]],
+) -> dict[str, Any]:
+    """Document-to-graph contract: v2 plus statement kind, attribution and quote context.
+
+    v1 and v2 are preserved unchanged. v3 adds only what the public document→graph flow
+    must request from the model (KUYEN_OPENAI_DOCUMENT_TO_GRAPH_E2E_01, §5):
+
+    * `statement_kind` on every relation and assertion — what kind of statement the source
+      makes, so a third-party claim is never persisted as a direct assertion;
+    * `attribution` on every relation and assertion — the actor the source attributes the
+      statement to, verbatim, or null when the document asserts it directly;
+    * `context` on every evidence object — the literal surrounding span, which the
+      application uses only to disambiguate a repeated quote (it is never trusted to
+      supply offsets);
+    * the structured `temporal` scope of v2, so dates and recurrences are requested.
 
+    The application resolves offsets deterministically; the model has no authority over
+    them. Every object still follows the strict Structured Outputs subset.
+    """
+    schema = build_extraction_schema_v2(
+        antu=antu, ontology=ontology, mapu_ids=mapu_ids, unit_ids=unit_ids,
+        source_uris=source_uris, source_sha256=source_sha256,
+        source_characters=source_characters, sections=sections,
+    )
+    for collection in ("relations", "assertions"):
+        item = schema["properties"][collection]["items"]
+        item["properties"]["statement_kind"] = _enum(list(STATEMENT_KINDS))
+        item["properties"]["statement_kind"]["description"] = (
+            "DIRECT_ASSERTION = the document itself asserts it; ATTRIBUTED_STATEMENT = "
+            "the document attributes it to an actor; THIRD_PARTY_CLAIM = a third party "
+            "claims it; ISSUER_REPORTED_FACT = the issuer reports having done or observed "
+            "it; FUTURE_COMMITMENT = a promise about the future; FORECAST = an expectation "
+            "about the future; PENDING_VERIFICATION = stated but not yet accredited; "
+            "NO_INFORMATION = the source says that information is missing.")
+        item["properties"]["attribution"] = _nullable("string")
+        item["properties"]["attribution"]["description"] = (
+            "The actor the source attributes this statement to, copied verbatim from the "
+            "source; null when the document asserts it in its own voice.")
+        item["properties"]["epistemic_status"]["description"] = (
+            "UNRESOLVED or NOT_EVALUATED only: the extractor never verifies a statement.")
+        item["required"] = list(item["properties"])
+    evidence = schema["properties"]["evidence"]["items"]
+    # v3 replaces the opaque `context_ref` of v1 with the literal surrounding text.
+    evidence["properties"].pop("context_ref", None)
+    evidence["properties"]["context"] = _nullable("string")
+    evidence["properties"]["context"]["description"] = (
+        "The literal sentence or clause around the quote, copied verbatim from the "
+        "source; used only to disambiguate a repeated quote, never to derive offsets.")
+    evidence["properties"]["quote"]["description"] = (
+        "An exact substring of the source, copied character for character. Do not "
+        "paraphrase, normalize, translate or add ellipses.")
+    evidence["required"] = list(evidence["properties"])
+    schema["properties"]["coverage"]["properties"]["units_used"]["description"] = (
+        "Every unit you actually read. KÜYEN derives the final coverage state.")
+    return schema
 
