{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leftraru.local/kuyen/evidence.schema.json",
  "title": "KÜYEN evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "mapu_id", "source_uri", "source_sha256", "quote", "char_start", "char_end", "offset_unit", "extraction_method", "validation_status"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^ev_[a-f0-9]{20}$"},
    "mapu_id": {"type": "string", "pattern": "^MAPU-[A-Za-z0-9._-]+$"},
    "source_uri": {"type": "string", "pattern": "^viking://"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "quote": {"type": "string", "minLength": 1},
    "char_start": {"type": "integer", "minimum": 0},
    "char_end": {"type": "integer", "minimum": 1},
    "offset_unit": {"const": "unicode_codepoint"},
    "extraction_method": {"type": "string", "minLength": 1},
    "validation_status": {"enum": ["NOT_EVALUATED", "SOURCE_VERIFIED", "INVALID", "UNRESOLVED"]}
  }
}
